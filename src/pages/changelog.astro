---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChangelogEntry from '../components/ChangelogEntry.astro';
---
<BaseLayout
  title="Changelog"
  description="Release history and notes for KangPaket."
>
  <Navbar />
  <main class="mx-auto max-w-2xl px-4 sm:px-6 py-16 md:py-24">
    <div class="mb-12">
      <h1 class="text-4xl font-semibold text-gray-50 mb-3">Changelog</h1>
      <p class="text-gray-400">
        Release history for KangPaket. View all releases on
        <a
          href="https://github.com/wantox86/KangPaket/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand hover:text-brand-dark transition-colors"
        >GitHub Releases</a>.
      </p>
    </div>

    <div class="relative">
      <ChangelogEntry version="v1.1.0" date="October 26, 2026">
        <ul>
          <li>New: Cloud Sync — sign in to a KangPaket server and your profiles and environments sync across devices. Accounts are created by the server admin. Logging out removes local data on that device, with a confirmation before switching accounts</li>
          <li>New: Environments &amp; Variables — use <code>{'{{var}}'}</code> in requests and the Collection Runner, switch environments from a dropdown, and import Postman variables</li>
          <li>New: Import from cURL — from the File menu, including "Copy as cURL" from browsers</li>
          <li>Fix: Add buttons in Params, Headers, Body, and Assertions are visible again</li>
          <li>Fix: Delete button in Environments is no longer cut off</li>
          <li>Fix: macOS About menu now shows version 1.1.0</li>
          <li>Fix: Cloud Sync login is no longer lost when the app is closed</li>
          <li>Upgrade note: app data is now stored per user (macOS: ~/Library/Application Support/KangPaket, Windows: %APPDATA%, Linux: ~/.local/share). Existing data is not migrated, so you need to sign in to Cloud Sync once more</li>
        </ul>
      </ChangelogEntry>

      <ChangelogEntry version="v1.0.2" date="October 6, 2026">
        <ul>
          <li>New: Assertions tab in the request panel — per-request assertions (status code, response time, body contains, JSON path, headers) evaluated by the Collection Runner</li>
          <li>Fix: Collection Runner crash</li>
          <li>Improved: sidebar list and runner checklist/result rows are now canvas-drawn for better performance with large collections</li>
          <li>Postman import keeps folder structure</li>
          <li>Availability: builds for Windows, macOS (Apple Silicon), and Linux (x86-64)</li>
        </ul>
      </ChangelogEntry>

      <ChangelogEntry version="v1.0.1" date="March 1, 2025">
        <ul>
          <li>Fix: PyInstaller bundle missing customtkinter</li>
          <li>Fix: httpx hidden import on Windows build</li>
        </ul>
      </ChangelogEntry>

      <ChangelogEntry version="v1.0.0" date="February 15, 2025">
        <ul>
          <li>Initial release</li>
          <li>HTTP request builder — all methods, auth, body types</li>
          <li>Collection Runner with 7 assertions</li>
          <li>Import from Postman Collection v2.0 & v2.1</li>
          <li>Export/import profile JSON</li>
        </ul>
      </ChangelogEntry>
    </div>
  </main>
  <Footer />
</BaseLayout>
